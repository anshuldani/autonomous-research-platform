# ── Anthropic ──────────────────────────────────────────────────────────────
# Used for: planning, synthesis (Sonnet 4.6), quality scoring, follow-up chat
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Tavily ─────────────────────────────────────────────────────────────────
# Used for: live web search (basic depth, parallel queries)
# Get from: https://app.tavily.com
TAVILY_API_KEY=

# ── Pinecone ───────────────────────────────────────────────────────────────
# Used for: vector storage of research chunks (follow-up RAG chat)
# Get from: https://app.pinecone.io  — create a serverless index named "research-platform"
PINECONE_API_KEY=

# ── Voyage AI ──────────────────────────────────────────────────────────────
# Used for: embedding research chunks before storing in Pinecone
# Get from: https://dash.voyageai.com
VOYAGE_API_KEY=

# ── Cohere (optional) ──────────────────────────────────────────────────────
# Used for: reranking retrieved chunks (improves follow-up chat relevance)
# Get from: https://dashboard.cohere.com  — leave blank to skip reranking
COHERE_API_KEY=
